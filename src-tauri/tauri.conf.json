{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZeroOne Agents Tools",
  "identifier": "com.zeroone.agents-tools",
  "version": "3.21.1",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ZeroOne Agents Tools",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGNzhENjAyM0ZDREIzRDEKUldUUnM4MC9BdFo0VDFJbDBtbzZhMVBUOEpmME1Nbk5nUy9QVUx6RUlmaVpOVDFpZVFMRUd5L2IK",
      "endpoints": [
        "https://github.com/Felipenogue91/zeroone-agents-tools/releases/latest/download/latest.json"
      ]
    }
  }
}
